{
  "manifest_version": 2,
  "name": "Everforest Dark",
  "version": "1.0",
  "description": "Everforest dark theme matching the desktop palette (bg #2b3339).",
  "browser_specific_settings": {
    "gecko": { "id": "everforest-dark@andwati" }
  },
  "theme": {
    "colors": {
      "frame": "#232a2e",
      "frame_inactive": "#232a2e",
      "tab_background_text": "#859289",
      "tab_text": "#d3c6aa",
      "tab_selected": "#2b3339",
      "tab_line": "#a7c080",
      "tab_loading": "#a7c080",
      "toolbar": "#2b3339",
      "toolbar_text": "#d3c6aa",
      "toolbar_vertical_separator": "#3d484d",
      "toolbar_field": "#343f44",
      "toolbar_field_text": "#d3c6aa",
      "toolbar_field_border": "#3d484d",
      "toolbar_field_focus": "#3d484d",
      "toolbar_field_text_focus": "#d3c6aa",
      "toolbar_field_border_focus": "#a7c080",
