      "popup_highlight_text": "#d3c6aa",
      "sidebar": "#232a2e",
      "sidebar_text": "#d3c6aa",
      "sidebar_border": "#3d484d",
      "sidebar_highlight": "#3c4841",
      "sidebar_highlight_text": "#d3c6aa",
      "ntp_background": "#2b3339",
